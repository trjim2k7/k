# This file contains example environment variables required for the FastAPI application.
# It should be renamed to .env and populated with actual values for development or production.
# For production, ensure all sensitive variables (especially SECRET_KEY and database credentials)
# are set to strong, unique, and securely managed values.

# --- Application Settings ---

# The secret key used for signing JWT tokens.
# CRITICAL FOR SECURITY: Generate a strong, random, and unique key for production.
# You can generate a good key with: openssl rand -hex 32 or python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="your-super-secret-key-for-jwt-do-not-use-in-production"

# The algorithm used for JWT token signing. HS256 is a common choice.
ALGORITHM="HS256"

# The number of minutes after which an access token will expire.
# Adjust based on your security requirements and user experience considerations.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database Settings (PostgreSQL) ---

# The hostname or IP address of the PostgreSQL database server.
# Use 'localhost' for local development or 'db' if using Docker Compose.
DB_HOST="localhost"

# The port number on which the PostgreSQL database server is listening.
# Default for PostgreSQL is 5432.
DB_PORT=5432

# The name of the database to connect to.
DB_NAME="fastapi_db"

# The username for connecting to the database.
DB_USER="user"

# The password for the database user.
# CRITICAL FOR SECURITY: Use a strong, unique password in production.
DB_PASSWORD="password"

# SQLAlchemy engine echo setting.
# Set to 'True' to log all SQL statements, useful for debugging/development.
# Set to 'False' for production environments to avoid performance overhead and sensitive data logging.
DATABASE_ECHO=True

# The number of connections to keep in the database pool.
# Adjust based on your application's expected concurrency and database server capabilities.
DATABASE_POOL_SIZE=10

# The maximum overflow size for the database connection pool.
# This means that an additional DATABASE_MAX_OVERFLOW connections can be opened
# temporarily beyond DATABASE_POOL_SIZE if needed.
DATABASE_MAX_OVERFLOW=20
